[run]
omit =
    */tests/*
    src/discover.py
    src/workflows/start.py
    src/workflows/epfr/tests/test_pdf_ocr.py

include =
    src/workflows/epfr/*

[report]
omit =
    */tests/*
    src/discover.py
    src/workflows/start.py
    src/workflows/epfr/tests/test_pdf_ocr.py

include =
    src/workflows/epfr/*
