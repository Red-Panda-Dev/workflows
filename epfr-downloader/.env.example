# EPFR Downloader Environment Variables
# Copy this file to .env and fill in your values

DEPLOYMENT_NAME=local

# =============================================================================
# Mistral AI API
# =============================================================================
# Required for AI distillation workflow (epfr-ai-distiller)
MISTRAL_API_KEY=your_mistral_api_key_here

# =============================================================================
# EPFR API Configuration
# =============================================================================
# Base URL for EPFR securities-market API
EPFR_BASE_API_URL=https://epfr.gov.by/portal/reporting/securities-market

# Template URL for file downloads
EPFR_FILE_DOWNLOAD_URL_TEMPLATE=https://epfr.gov.by/portal/file/{record_id}/content

# Default search query for dividend disclosures
EPFR_DEFAULT_SEARCH_QUERY=дивиденд

# Default sub-category ID for filtering
EPFR_DEFAULT_SUB_CATEGORY_ID=1

# Default sort field and direction
EPFR_DEFAULT_SORT_FIELD=realUploadDate
EPFR_DEFAULT_SORT_DIR=desc

# =============================================================================
# Pagination Settings
# =============================================================================
# Maximum number of pages to fetch
EPFR_MAX_PAGES=10

# First page number (zero-based)
EPFR_FIRST_PAGE_NO=0

# Delay between page requests (seconds)
EPFR_PAGE_DELAY=1.0

# =============================================================================
# Download Configuration
# =============================================================================
# Maximum concurrent downloads
EPFR_MAX_CONCURRENT_DOWNLOADS=10

# Download timeout (seconds)
EPFR_DOWNLOAD_TIMEOUT=120

# Number of download retries
EPFR_DOWNLOAD_RETRIES=3

# Chunk size for streaming downloads (bytes)
EPFR_CHUNK_SIZE=8192

# =============================================================================
# Retry Configuration
# =============================================================================
# Maximum retries for API requests
EPFR_MAX_RETRIES=3

# Retry backoff base (seconds)
EPFR_RETRY_BACKOFF_BASE=2

# Maximum retry backoff (seconds)
EPFR_RETRY_BACKOFF_MAX=30

# =============================================================================
# OCR Configuration
# =============================================================================
# Maximum concurrent OCR operations
EPFR_MAX_CONCURRENT_OCR=2

# Maximum PDF size for OCR (bytes) - 50MB default
EPFR_MAX_PDF_SIZE_BYTES=52428800

# OCR model to use
EPFR_OCR_MODEL=mistral-ocr-latest

# =============================================================================
# AI Distillation Configuration
# =============================================================================
# AI model for dividend extraction
EPFR_AI_MODEL=ministral-8b-latest

# AI temperature (0.0 for deterministic)
EPFR_AI_TEMPERATURE=0.0

# AI request timeout (seconds)
EPFR_AI_TIMEOUT=60

# Maximum AI retries
EPFR_AI_MAX_RETRIES=3

# AI retry backoff base (seconds)
EPFR_AI_RETRY_BACKOFF_BASE=2

# Delay between AI file processing (seconds)
EPFR_AI_FILE_DELAY=1

# =============================================================================
# Output Configuration
# =============================================================================
# Default output directory
EPFR_OUTPUT_DIR=output

# UNP file mapping filename
EPFR_MAPPING_FILENAME=unp_file_mapping.json

# AI distilled output filename
EPFR_AI_DISTILLED_FILENAME=ai_distilled_dividends.json

# =============================================================================
# Date Configuration
# =============================================================================
# Default date filter (YYYY-MM-DD format)
# Leave empty to use current date or specify a start date
EPFR_DEFAULT_DATE_FROM=2022-01-01
