#!/usr/bin/env bash
# Wrapper for uv that prefers the active virtual environment for commands that
# support --active. uv treats --active as a command-specific option, not a
# global option, so it must be placed after the subcommand.

REAL_UV="/home/homer/.local/bin/uv"

case "${1:-}" in
    add|run|sync)
        # Avoid passing --active twice if the caller already provided it.
        for arg in "${@:2}"; do
            if [ "$arg" = "--active" ]; then
                exec "$REAL_UV" "$@"
            fi
        done
        exec "$REAL_UV" "$1" --active "${@:2}"
        ;;
    *)
        exec "$REAL_UV" "$@"
        ;;
esac
